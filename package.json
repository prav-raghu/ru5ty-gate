{
    "name": "ru5ty-gate",
    "private": true,
    "packageManager": "pnpm@11.5.0",
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=11.0.0"
    },
    "scripts": {
        "dev": "pnpm dev:backend",
        "dev:backend": "bash devops/scripts/dev.sh",
        "dev:agent": "cargo run -p ru5ty-gate-agent -- --config apps/backend/agent/config/agent.toml",
        "dev:customer-web": "pnpm --filter customer-web dev",
        "dev:admin-web": "pnpm --filter admin-web dev",
        "dev:mobile": "pnpm --filter customer-mobile dev",
        "build": "turbo run build",
        "test": "turbo run test",
        "test:coverage": "turbo run test:coverage",
        "lint": "eslint . && pnpm lint:rust",
        "lint:fix": "eslint . --fix",
        "lint:rust": "cargo clippy --workspace --all-targets --locked -- -D warnings",
        "lint:turbo": "turbo run lint",
        "typecheck": "turbo run typecheck && pnpm typecheck:rust",
        "typecheck:rust": "cargo check --workspace --all-targets --locked",
        "test:rust": "cargo test --workspace --locked",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" && cargo fmt --all",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" && cargo fmt --all -- --check",
        "clean": "turbo run clean && rm -rf node_modules",
        "update-deps": "pnpm -r update --latest",
        "update-deps:interactive": "pnpm -r update --interactive --latest",
        "changeset": "changeset",
        "changeset:version": "changeset version",
        "changeset:publish": "pnpm build && changeset publish",
        "changeset:status": "changeset status",
        "release": "semantic-release",
        "release:dry-run": "semantic-release --dry-run --no-ci",
        "dev:cms": "npm --prefix apps/cms install --legacy-peer-deps && npm --prefix apps/cms run develop",
        "n8n:local": "tsx apps/automation/n8n/scripts/start-local.ts",
        "n8n:create-instance": "tsx apps/automation/n8n/scripts/create-instance.ts",
        "sonar": "sonar-scanner",
        "prepare": "husky"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.7.0",
        "@changesets/cli": "^2.31.1",
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@eslint/js": "^10.0.1",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/github": "^11.0.6",
        "@semantic-release/npm": "^12.0.2",
        "@semantic-release/release-notes-generator": "^14.1.1",
        "@types/node": "^25.9.9",
        "conventional-changelog-conventionalcommits": "^8.0.0",
        "eslint": "^10.12.0",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-unicorn": "^64.0.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.9",
        "semantic-release": "^24.2.9",
        "tsx": "^4.23.15",
        "turbo": "^2.11.7",
        "typescript-eslint": "^8.71.0"
    }
}
