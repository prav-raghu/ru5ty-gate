# Required: full connection string (managed Redis on Coolify, ElastiCache, etc.)
# redis://[:password@]host:port or rediss://[:password@]host:port for TLS
REDIS_URL=rediss://:supersecret@redis.randomhost.io:6379

# For rediss:// URLs the managed self-signed cert is accepted by default.
# Set to true only when Redis presents a CA-signed certificate.
REDIS_TLS_REJECT_UNAUTHORIZED=false
