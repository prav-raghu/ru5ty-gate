APP_ENV=development
PORT=4003
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:4004
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ru5ty_gate
REDIS_URL=redis://localhost:6379
# Minimum 32 characters - generate with: openssl rand -hex 32
SCHEDULE_API_KEY=your-secret-api-key-minimum-32-chars-here
SCHEDULE_WEBHOOK_INTERVAL_SECONDS=60
# Sentry - leave empty to disable error monitoring (local dev)
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
