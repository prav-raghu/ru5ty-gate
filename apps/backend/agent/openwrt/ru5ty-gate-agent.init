#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/ru5ty-gate-agent
CONF=/etc/ru5ty-gate/agent.toml

start_service() {
	[ -r "$CONF" ] || {
		logger -t ru5ty-gate-agent "missing config $CONF"
		return 1
	}
	mkdir -p /var/lib/ru5ty-gate
	chmod 700 /var/lib/ru5ty-gate

	procd_open_instance
	procd_set_param command "$PROG" --config "$CONF"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$CONF"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger ru5ty-gate-agent
}
