APP_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:4005
# Reverse proxies in front of this service (Traefik, the gateway). 0 trusts only the direct peer.
TRUSTED_PROXY_HOPS=1
ADMIN_API_URL=http://localhost:4001
CUSTOMER_API_URL=http://localhost:4002
SCHEDULER_API_URL=http://localhost:4003
RATE_LIMIT_MAX=200
# Enables GET /metrics for Prometheus (Authorization: Bearer <token>, at least 16 characters). Leave unset to keep /metrics off.
# METRICS_TOKEN=
GRAPHQL_ENABLED=true
GRAPHQL_PATH=/graphql
GRAPHQL_PLAYGROUND=true
GRAPHQL_INTROSPECTION=true
# Sentry - leave empty to disable error monitoring (local dev)
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
