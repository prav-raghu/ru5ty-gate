APP_ENV=development
PORT=4001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:4004
# Reverse proxies in front of this service (Traefik, the gateway). 0 trusts only the direct peer.
TRUSTED_PROXY_HOPS=1
ADMIN_WEB_URL=http://localhost:4004
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ru5ty_gate
REDIS_URL=redis://localhost:6379
# Both secrets need at least 32 characters - generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
# Exactly 64 hex characters - generate with: openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY_64_CHARS
PASSWORD_RESET_EXPIRATION_MINUTES=60
# Enables the one-time POST /auth/bootstrap-admin route - set to false once the first SUPER_ADMIN exists
ADMIN_BOOTSTRAP_ENABLED=true
MAILTRAP_API_KEY=your_mailtrap_api_key
MAILTRAP_FROM=noreply@yourdomain.com
MAILTRAP_FROM_NAME="Your App Name"
MAILTRAP_TEST_INBOX_ID=12345678
# Sentry - leave empty to disable error monitoring (local dev)
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
