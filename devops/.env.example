# Environment variable contract for the root docker-compose.yaml (Coolify stack).
# In Coolify, set every value in the Docker Compose resource's Environment Variables
# panel. Mark secrets as Secret; mark NEXT_PUBLIC_* and VITE_* as Build Variables.
# Never commit real values — this file documents the contract only.

# ---------------------------------------------------------------------------
# Core infrastructure (all backend services)
# ---------------------------------------------------------------------------
# Postgres + Redis are Coolify-managed resources — use their internal URLs.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
REDIS_URL=redis://:PASSWORD@HOST:6379
# false for Coolify-managed Redis (self-signed / no TLS); true for TLS providers.
REDIS_TLS_REJECT_UNAUTHORIZED=false

# ---------------------------------------------------------------------------
# Auth / tokens (admin-api, customer-api)
# ---------------------------------------------------------------------------
# Generate each with: openssl rand -hex 32
JWT_SECRET=change_me_64_hex_chars
JWT_REFRESH_SECRET=change_me_64_hex_chars
AUTH_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
PASSWORD_RESET_EXPIRATION_MINUTES=30
# 32 hex chars — admin-api 2FA TOTP encryption. openssl rand -hex 16
TWO_FACTOR_ENCRYPTION_KEY=change_me_32_hex_chars

# ---------------------------------------------------------------------------
# schedule-api
# ---------------------------------------------------------------------------
# Shared secret the gateway/callers present to schedule-api. openssl rand -hex 32
SCHEDULE_API_KEY=change_me_32_hex_chars_min

# ---------------------------------------------------------------------------
# Rate limiting (all backend services)
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_MAX=100

# ---------------------------------------------------------------------------
# Application URLs (CORS origins + redirects)
# ---------------------------------------------------------------------------
CUSTOMER_WEB_URL=https://example.com
ADMIN_WEB_URL=https://admin.example.com

# ---------------------------------------------------------------------------
# Email — Mailtrap (admin-api, customer-api)
# ---------------------------------------------------------------------------
MAILTRAP_API_KEY=
MAILTRAP_FROM=noreply@example.com
MAILTRAP_FROM_NAME=Example

# ---------------------------------------------------------------------------
# Payments — Stripe (customer-api) — only if payments are enabled
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# SMS — SMSPortal (admin-api, customer-api) — only if SMS is enabled
# ---------------------------------------------------------------------------
SMSPORTAL_CLIENT_ID=
SMSPORTAL_API_SECRET=

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Sentry — leave SENTRY_DSN empty to disable error monitoring (local dev).
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Source map upload at build time (set as Build Variables in Coolify).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Frontend browser DSNs (set as Build Variables in Coolify).
VITE_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Frontend build-time args (set as Build Variables in Coolify)
# ---------------------------------------------------------------------------
# customer-web (Next.js)
NEXT_PUBLIC_CUSTOMER_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_CUSTOMER_APP_NAME=customer-web
# admin-web (Vite)
VITE_ADMIN_API_BASE_URL=https://api.example.com
VITE_ADMIN_APP_NAME=admin-web

# ---------------------------------------------------------------------------
# Image tag for the compose stack (optional; defaults to latest)
# ---------------------------------------------------------------------------
IMAGE_TAG=latest

# ===========================================================================
# n8n Workflow Automation (separate instance — see
# apps/automation/n8n/compose/.env.example for the full set)
# ===========================================================================
# N8N_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32
# N8N_HOST=localhost
# N8N_PORT=5678
# N8N_PROTOCOL=http
# N8N_WEBHOOK_URL=http://localhost:5678
